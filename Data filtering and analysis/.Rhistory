color = scatter_color
)
) +
geom_point(alpha = 0.7) +
geom_vline(
xintercept = 10,
linetype = "dashed",
color = "gray50",
linewidth = 0.8
) +
geom_vline(
xintercept = 52,
linetype = "dashed",
color = "gray30",
linewidth = 0.8
) +
# Labels only in top facet
geom_text(
data = line_labels,
aes(x = x, y = y, label = label),
inherit.aes = FALSE,
size = 3.2,
color = "gray30"
) +
facet_wrap(~ establishment_size, ncol = 1) +
scale_size_area(
max_size = 12,
breaks = c(5, 10, 20),
name = "Number of moving windows"
) +
scale_color_manual(
values = c(
"Category 1" = "#4C956C",
"Category 2" = "#F4A261",
"Category 3" = "#C8553D",
"Less than 10 samples" = "gray50"
),
guide = "none"
) +
scale_x_continuous(
breaks = seq(0, 65, 5),
limits = c(0, 65)
) +
scale_y_continuous(
breaks = seq(0, 60, 10),
limits = c(0, 60)
) +
labs(
x = "Number of samples collected from one establishment in one moving window",
y = "Percent positive for one establishment in one moving window"
) +
theme_bw(base_size = 15) +
theme(
panel.grid.minor = element_blank(),
strip.background = element_rect(fill = "gray90")
)
# --- BAR PLOT ---
p_bar <- ggplot(
bar_data,
aes(x = category)
) +
# Colored portion: >=10 samples
geom_col(
aes(y = ge10_proportion, fill = category),
color = "black",
linewidth = 0.2,
alpha = 0.8
) +
# Gray portion: <10 samples, stacked ON TOP
geom_rect(
aes(
xmin = as.numeric(category) - 0.45,
xmax = as.numeric(category) + 0.45,
ymin = ge10_proportion,
ymax = proportion,
fill = "Number of samples <10"
),
color = "black",
linewidth = 0.2
) +
# >=10 percentage inside colored area
geom_text(
aes(
y = ge10_proportion / 2,
label = scales::percent(ge10_proportion, accuracy = 0.1)
),
size = 4.2
) +
# Overall percentage at top
geom_text(
aes(
y = proportion,
label = scales::percent(proportion, accuracy = 0.1)
),
vjust = -0.5,
size = 4.5
) +
facet_wrap(~ establishment_size, ncol = 1) +
scale_fill_manual(
values = c(
cat_colors,
"Number of samples <10" = "gray50"
),
breaks = c(
"Category 1",
"Category 2",
"Category 3",
"Number of samples <10"
),
name = NULL
) +
scale_y_continuous(
labels = scales::percent_format(),
limits = c(0, 1.1)
) +
labs(
x = NULL,
y = "Proportion of Categorization"
) +
theme_bw(base_size = 15) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
# --- COMBINE WITH PATCHWORK ---
final_plot <- p_scatter + p_bar +
plot_layout(widths = c(3, 1), guides = "collect") &
theme(legend.position = "bottom")
# Display the plot
final_plot
ggsave( "figures/percent_positive_by_sample_size_withprop_monthly_grey.jpg", plot = final_plot, width = 12, height = 9, dpi = 600)
plot_data_test <- read.csv("prevalencebasedresults_withNAcategory_monthly.csv")
plot_data_test$end_date <- anydate(plot_data_test$end_date)
plot_data_test <- subset(plot_data_test, plot_data_test$end_date > "2023-01-01")
plot_data_test <- plot_data_test %>%
count(
end_date,
establishment_id,
establishment_size,
total_sample_no,
percent_pos_adj,
name = "n"
)
# 1. Prepare the Data
# --- SCATTER DATA ---
plot_data_test <- plot_data_test %>%
mutate(
category = cut(
percent_pos_adj,
breaks = c(-Inf, 7.7, 15.4, Inf),
labels = c("Category 1", "Category 2", "Category 3"),
right = FALSE
),
scatter_color = ifelse(
total_sample_no < 10,
"Less than 10 samples",
as.character(category)
)
)
table(plot_data_test$establishment_size)
table(plot_data_test$establishment_size,plot_data_test$category)
prop.table(table(plot_data_test$establishment_size,plot_data_test$category), margin = 1)
chisq.test(table(plot_data_test$category, plot_data_test$establishment_size))
# Overall contingency table
tab <- table(
plot_data_test$category,
plot_data_test$establishment_size
)
# Overall chi-square test
chisq.test(tab)
# Pairwise post-hoc chi-square tests
sizes <- colnames(tab)
pairs <- combn(sizes, 2, simplify = FALSE)
posthoc <- do.call(rbind, lapply(pairs, function(x) {
temp_tab <- tab[, x, drop = FALSE]
test <- chisq.test(temp_tab)
data.frame(
Group1 = x[1],
Group2 = x[2],
Chi_square = unname(test$statistic),
df = unname(test$parameter),
p_value = test$p.value
)
}))
# Adjust for 3 pairwise comparisons
posthoc$p_adjusted <- p.adjust(
posthoc$p_value,
method = "holm"
)
posthoc
plot_data_gt10 <- plot_data_test[plot_data_test$scatter_color!="Less than 10 samples",]
table(plot_data_gt10$establishment_size)
table(plot_data_gt10$establishment_size,plot_data_gt10$category)
prop.table(table(plot_data_gt10$establishment_size,plot_data_gt10$category), margin = 1)
chisq.test(table(plot_data_gt10$category, plot_data_gt10$establishment_size))
# Overall contingency table
tab_gt10 <- table(
plot_data_gt10$category,
plot_data_gt10$establishment_size
)
# Overall chi-square test
chisq.test(tab_gt10)
# Pairwise post-hoc chi-square tests
sizes <- colnames(tab_gt10)
pairs <- combn(sizes, 2, simplify = FALSE)
posthoc <- do.call(rbind, lapply(pairs, function(x) {
temp_tab <- tab_gt10[, x, drop = FALSE]
test <- chisq.test(temp_tab)
data.frame(
Group1 = x[1],
Group2 = x[2],
Chi_square = unname(test$statistic),
df = unname(test$parameter),
p_value = test$p.value
)
}))
# Adjust for 3 pairwise comparisons
posthoc$p_adjusted <- p.adjust(
posthoc$p_value,
method = "holm"
)
posthoc
table(plot_data_test$establishment_size)
# Calculate category proportions
plot_data_filtered <- plot_data %>%
filter(total_sample_no >= 10)
plot_prop <- plot_data_filtered %>%
group_by(end_date, establishment_size, category) %>%
summarise(
n = sum(n),
.groups = "drop"
) %>%
group_by(end_date, establishment_size) %>%
mutate(
proportion = n / sum(n) * 100
) %>%
ungroup()
# Calculate "All" establishments
plot_all <- plot_data %>%
group_by(end_date, category) %>%
summarise(
n = sum(n),
.groups = "drop"
) %>%
group_by(end_date) %>%
mutate(
proportion = n / sum(n) * 100,
establishment_size = "All"
) %>%
ungroup()
# Combine All + establishment size groups
plot_prop <- bind_rows(plot_all, plot_prop) %>%
mutate(
establishment_size = factor(
establishment_size,
levels = c("All", "Large", "Small", "Very Small")
),
category = factor(
category,
levels = c("Category 1", "Category 2", "Category 3")
)
)
# Category colors
cat_colors <- c(
"Category 1" = "#4C956C",
"Category 2" = "#F4A261",
"Category 3" = "#C8553D"
)
# Calculate category proportions by establishment size
plot_prop <- plot_data %>%
group_by(end_date, establishment_size, category) %>%
summarise(
n = sum(n),
.groups = "drop"
) %>%
group_by(end_date, establishment_size) %>%
mutate(
proportion = n / sum(n) * 100
) %>%
ungroup()
# Calculate "All" establishments
plot_all <- plot_data %>%
group_by(end_date, category) %>%
summarise(
n = sum(n),
.groups = "drop"
) %>%
group_by(end_date) %>%
mutate(
proportion = n / sum(n) * 100,
establishment_size = "All"
) %>%
ungroup()
# Combine
plot_prop <- bind_rows(plot_all, plot_prop) %>%
mutate(
establishment_size = factor(
establishment_size,
levels = c("All", "Large", "Small", "Very Small")
),
category = factor(
category,
levels = c("Category 1", "Category 2", "Category 3")
)
)
# Plot
category_overtime <- ggplot(
plot_prop,
aes(
x = end_date,
y = proportion,
color = category,
group = category
)
) +
# Trend lines
geom_line(
linewidth = 0.9
) +
# Observed values
geom_point(
size = 2,
stroke = 0
) +
facet_wrap(
~ establishment_size,
ncol = 1
) +
scale_color_manual(
values = cat_colors,
name = "Category"
) +
scale_y_continuous(
limits = c(0, 100),
breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%"),
expand = expansion(mult = c(0, 0.02))
) +
scale_x_date(
date_breaks = "3 months",
date_labels = "%b\n%Y",
expand = expansion(mult = c(0.01, 0.02))
) +
labs(
x = "Time",
y = "Proportion of establishments",
title = "(b) Proportion of establishment catgeories over time"
) +
theme_classic(base_size = 15) +
theme(
legend.position = "right",
# Facet labels
strip.background = element_rect(
fill = "grey92",
color = NA
),
strip.text = element_text(
face = "bold",
size = 12
),
# Axes
axis.text.x = element_text(
angle = 0,
hjust = 1,
vjust = 1
),
# Light horizontal reference lines
panel.grid.major.y = element_line(
color = "grey90",
linewidth = 0.3
),
panel.grid.minor = element_blank(),
# Space between panels
panel.spacing = unit(0.8, "lines"),
# Legend
legend.title = element_text(face = "bold"),
legend.key.width = unit(1.2, "cm")
)
category_overtime
#ggsave("category_plot_byest_overtime.jpg", category_overtime, width = 10, height = 15)
# Create month-year
prevalence_data <- prevalence_data %>%
mutate(
month_year = as.Date(
format(as.Date(collection_date), "%Y-%m-01")
)
)
# 1. Monthly prevalence by establishment size
prevalence_parts <- prevalence_data %>%
filter(!is.na(salmonella_sp_analysis),
!is.na(establishment_size)) %>%
group_by(month_year, establishment_size) %>%
summarise(
Total = n(),
Positive = sum(salmonella_sp_analysis == "Positive"),
.groups = "drop"
) %>%
rowwise() %>%
mutate(
CI = list(binom.test(Positive, Total)$conf.int),
CI_Lower = CI[1],
CI_Upper = CI[2]
) %>%
ungroup() %>%
select(-CI) %>%
mutate(
Percent_Positive = Positive / Total,
Establishment_Size = as.character(establishment_size)
)
# 2. Overall monthly prevalence
prevalence_all <- prevalence_data %>%
filter(!is.na(salmonella_sp_analysis)) %>%
group_by(month_year) %>%
summarise(
Total = n(),
Positive = sum(salmonella_sp_analysis == "Positive"),
.groups = "drop"
) %>%
rowwise() %>%
mutate(
CI = list(binom.test(Positive, Total)$conf.int),
CI_Lower = CI[1],
CI_Upper = CI[2]
) %>%
ungroup() %>%
select(-CI) %>%
mutate(
Percent_Positive = Positive / Total,
Establishment_Size = "All"
)
# 3. Combine
prevalence_plot <- bind_rows(
prevalence_all,
prevalence_parts
) %>%
mutate(
Month_Year = month_year,
Month = format(month_year, "%b"),
Year = factor(format(month_year, "%Y")),
Month_num = as.numeric(format(month_year, "%m")),
Establishment_Size = factor(
Establishment_Size,
levels = c(
"All",
"Large",
"Small",
"Very Small"
)
)
)
# Plot
p_salmonella_est <- ggplot(
prevalence_plot,
aes(
x = Month_Year,
y = Percent_Positive * 100,
color = Establishment_Size,
group = Establishment_Size
)
) +
geom_line(
linewidth = 0.8
) +
geom_point(
size = 1.8
) +
labs(
x = NULL,
y = expression(""*italic("Salmonella")*" Positive (%)"),
color = "Establishment Size",
title = expression(
"(a) "*italic("Salmonella")*
" Positive across establishment sizes over time"
)
) +
scale_color_manual(
values = c(
"All" = "black",
"Large" = "#F28E2B",
"Small" = "#a559aa",
"Very Small" = "#4E79A7"
)
) +
scale_x_date(
date_breaks = "3 months",
date_labels = "%b\n%Y",
expand = expansion(mult = c(0.01, 0.02))
) +
scale_y_continuous(
limits = c(0, NA),
expand = expansion(mult = c(0, 0.05))
) +
theme_classic(base_size = 15) +
theme(
legend.position = "right",
axis.text.x = element_text(
angle = 0,
hjust = 1,
vjust = 1
),
panel.grid.major.y = element_line(
linewidth = 0.3,
color = "grey90"
)
)
p_salmonella_est
combined_category_plot <-
p_salmonella_est / category_overtime +
plot_layout(widths = c(1, 1),heights = c(1,3))
ggsave("figures/category_plot_byest.jpg", combined_category_plot, width = 10, height = 15)
